    "title": "袋熊羈絆儀式",
    "unlock_stage_min": "mature",
    "requirements": {
      "current_bond_gte": 90,
      "care_mistakes_last_1440_game_minutes_eq": 0,
      "distinct_valid_care_action_types_last_1440_game_minutes_gte": 3
