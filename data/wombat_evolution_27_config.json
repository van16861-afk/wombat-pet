    "action": "show a one-time voluntary story event on the status panel; after user taps complete and animation resolves, increment bond_event_count exactly once in lifetime",
    "types_counted": [
      "valid_feed",
      "effective_clean",
      "play",
      "complete_sleep",
      "night_explore"
