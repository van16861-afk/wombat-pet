  "decision": {
    "algorithm": "when stage timer matures, collect edges from current form, filter eligible, sort by priority DESC then matching_affinity_score DESC then target id ASC; choose top; if none and stage=perfect, stay and recheck each 360 game minutes",
    "stage_transition_atomic": true,
    "one_evolution_per_boundary": true,
    "tie_break": "priority desc > matching_affinity_score desc > destination_id lex asc",
    "fallbacks": "baby2/growth/mature branches each must include exactly one always edge; perfect none",
    "preview": "show eligibility hints but do not expose exact thresholds unless revealed in encyclopedia",
    "eligibility_freeze": "take immutable phase snapshot when evaluating; do not mutate source form until evolution sequence resolves"
  },
  "scoring": {
    "care_score": {
      "expression": "clamp(0,100,0.16*avg_hunger+0.11*avg_thirst+0.15*avg_hygiene+0.13*avg_mood+0.20*avg_health+0.15*avg_bond+0.10*sleep_routine_ratio*100)",
      "weights_total": 1.0
    },
    "ratio_denominators": "all time ratios use integrated game time and never direct wall-clock time; action ratios with denominator 0 -> 0",
    "affinity": "for each affinity, current_phase_affinity = clamp(0,100, 0.25*previous_phase_final_affinity + 0.75*current_phase_action_share_percent). The current phase scores are updated after valid events. On phase entry, retain prior score as seed. The map from action to affinity is configurable; no free idle farming.",
    "actions_to_affinity": {
      "dig": [
        "earth"
      ],
      "flower": [
        "nature"
      ],
      "chase": [
        "wind"
      ],
      "vigorous_play": [
        "fire"
      ],
      "regular_sleep": [
        "star"
      ],
      "night_explore": [
        "abyss",
        "star"
      ],
      "care_bond_event": [
        "star"
      ]
    },
    "eligibility_note": "rare 85+ requires meaningful repeated investment across stages; 0 event samples set current action share 0, never infer 100% from 0/0"
  },
  "anti_abuse": {
    "effective_action": "event accepted only if cooldown satisfied, state actually changes or gameplay task completed; no repeated tap farming",
    "per_action_event_cooldown_real_seconds": 5,
    "fast_speed_evolution_grace_real_seconds": 30,
    "grace": "upon timer threshold reach show ready animation/control, allow up to 30 real seconds for last actions in high-speed play, freeze elapsed phase duration once boundary reached; game state is not frozen except evolution decision; auto-confirm at grace expiry. Expose optional instant-evolve button.",
    "one_mistake_per_call": "hunger/thirst/health/sleep-call timeout only recorded once per distinct unresolved call; do not accumulate each minute",
    "missed_call_grace_game_minutes": 10,
    "missed_call_min_real_seconds": 30,
    "skill_reward_cap": "per-game-day caps enforced even at 60x speed; once/day reset based on game_day_number",
    "min_activity_samples": "Use meaningful phase counts in edge conditions; a single-click 100% share does not qualify for paths requiring >=2 sessions",
    "sleep_and_aging": "time progression and hunger/decay/sleep rules must be consistent across all speeds with delta_game_minutes; no skipped threshold events"
  },
